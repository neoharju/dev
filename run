#!/usr/bin/env bash
# run
#
# Executes every executable script under packages.d/ or a single one 
# if FILTER is given. This is the "install software" entrypoint; 
# see ./dev-env for "install dotfiles/configs".
#
# Confirms before each target by default -- some of these (HyDE
# especially) run their own large, interactive installers that this
# script has no control over once started.
# Pass --yes to skip the prompts.
#
# A hard failure (non-zero exit) always stops the run immediately and
# prints which targets were not attempted.
#
# Usage:
#   DEV_ENV=$(pwd) ./run [--dry] [--list] [--yes] [FILTER]
#
#   FILTER   Exact match against packages.d/* filenames, e.g. "vim" runs
#            packages.d/vim 
#   --dry    print what would run without running it.
#   --list   print matching targets and exit.
#   --yes    don't confirm before each target.
#
# Examples:
#   ./run --dry          # show every target that would run
#   ./run dev            # install just packages.d/dev
#   ./run                # install everything, in filename order, confirming each
#   ./run --yes          # install everything, no per-target prompts
#

set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
# shellcheck source=lib/preinstall.sh
source "$script_dir/lib/preinstall.sh"

prechecks() {
    local available_mb
    available_mb="$(disk_space_mb)"
    if (( available_mb < MIN_DISK_MB )); then
        log_warn "Only $available_mb MB disk space available."
    fi
    require_pacman
    require_not_root
}

prechecks
check_sudo

usage() {
    cat <<'EOF'
Usage: DEV_ENV=$(pwd) ./run [--dry] [--list] [--yes] [FILTER]

  FILTER   Exact match against packages.d/* filenames, e.g. "vim" runs
           packages.d/vim but not packages.d/neovim.
  --dry    print what would run without running it.
  --list   print matching targets and exit.
  --yes    don't confirm before each target.
EOF
}
if [[ -z "${DEV_ENV:-}" ]]; then
    die "env var DEV_ENV needs to be present (e.g. DEV_ENV=\$(pwd) ./run)"
fi

filter=""
list_only="0"
skip_confirm="0"

while (($# > 0)); do
    case "$1" in
        --dry)
            DRY_RUN="1"
            ;;
        --list)
            list_only="1"
            ;;
        --yes)
            skip_confirm="1"
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            filter="$1"
            ;;
    esac
    shift
done

log_info "DEV_ENV=$DEV_ENV${filter:+, filter=\"$filter\"}"

cd -- "$script_dir"

# -maxdepth 1 -mindepth 1: only direct children of packages.d/ 
# -print0 / mapfile -d '': robust against filenames containing whitespace.
mapfile -d '' -t scripts < <(find ./packages.d -maxdepth 1 -mindepth 1 -type f -executable -print0 | sort -z)

if ((${#scripts[@]} == 0)); then
    die "No executable scripts found under ./packages.d"
fi

matched=()
for script in "${scripts[@]}"; do
	name=$(basename -- "$script")
    lookup_name="${name#[0-9][0-9]-}"
    # exact match on basename without prefix nums
    if [[ -n "$filter" && 
        "$lookup_name" != "$filter" &&
        "$name" != "$filter" ]]; then
        continue
    fi
    matched+=("$script")
done

if ((${#matched[@]} == 0)); then
    die "no packages.d/* target matches filter \"$filter\" - exact match required."
fi

# list install scripts via --list from packages.d
if [[ "$list_only" == "1" ]]; then
    printf '%s\n' "${matched[@]}"
    exit 0
fi

# The HyDE answers needed 
declare -A interactive_warnings=(
    [HyDE]="HyDE's is interactive. The answers that work with this repo's 
    follow-up packages.d/dev script:
    
    - \"Install Chaotic AUR?\"  -> No
    - \"Which AUR helper?\"     -> paru (packages.d/dev requires it)
    - Shell choice            -> zsh
    - Rust choice             -> rust (not rustup)

  Read every prompt yourself regardless; this is a guide, not a
  guarantee that HyDE hasn't changed since."
)

total=${#matched[@]}
i=0
completed=()
for script in "${matched[@]}"; do
    i=$((i+1))
    name=$(basename -- "$script")
    lookup_name="${name#[0-9][0-9]-}"

    echo
    log_info "[$i/$total] $script"
    if [[ -n "${interactive_warnings[$lookup_name]:-}" ]]; then
        log_warn "${interactive_warnings[$lookup_name]}"
    fi

    if [[ "$skip_confirm" != "1" ]] && ! confirm "Run $script now?"; then
        log_info "skipped $script"
        continue
    fi

    if run_cmd "$script"; then
		completed+=("$name")
		:
    else
        status=$?
        # 130 = 128 + SIGINT; you pressed ctrl+C
		if ((status == 130)); then
			log_warn "$script interrupted (Ctrl+C)."
		else
			log_error "$script failed (exit $status)"
		fi

		if ((${#completed[@]} > 0)); then
			log_info "Completed: ${completed[*]}"
		fi
		log_info "Did not complete: $name"

        remaining=("${matched[@]:i}")
        if ((${#remaining[@]} > 0)); then
            log_error "stopping here, not attempted: ${remaining[*]#./packages.d/}"
        fi
        exit "$status"
    fi
done

log_ok "done (${#matched[@]} target(s))"
