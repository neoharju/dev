#!/usr/bin/env bash
# packages.d/perf profiling and debug stack
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$script_dir/lib/common.sh"

log_info "---- perf ----"

debuggers=(gdb valgrind heaptrack strace ltrace)
profilers=(perf hyperfine)
hardware_awareness=(numactl hwloc turbostat)

run_cmd sudo pacman -S --noconfirm --needed "${debuggers[@]}" "${profilers[@]}" "${hardware_awareness[@]}" 

