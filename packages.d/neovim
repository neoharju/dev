#!/usr/bin/env bash
# packages.d/neovim
#
# Build neovim from source (stable branch) and grab plenary
# Plenary is needed for several neovim plugins
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd) 
# shellcheck source=../lib/common.sh
source "$script_dir/lib/common.sh"
# shellcheck source=../lib/optimize.sh
source "$script_dir/lib/optimize.sh"

personal_dir="$HOME/personal"
nvim_src="$personal_dir/neovim"
plenary_src="$personal_dir/plenary.nvim"

mkdir -p -- "$personal_dir"

if [[ -d "$nvim_src/.git" ]]; then
	log_info "neovim already cloned at $nvim_src, pulling latest instead"
	if  confirm "Clean previous neovim build? "; then
		(
			cd -- "$nvim_src"
			run_cmd sudo make clean
			run_cmd sudo make distclean
		)
	fi
	run_cmd git -C "$nvim_src" pull --ff-only
else
	run_cmd git clone -b master https://github.com/neovim/neovim.git "$nvim_src"
fi


(
	cd -- "$nvim_src"
	run_cmd make CMAKE_BUILD_TYPE=Release
	run_cmd sudo make install
)


if [[ -d "$plenary_src/.git" ]]; then
	log_info "plenary.nvim already cloned at $plenary_src, pulling latest instead"
	run_cmd git -C "$plenary_src" pull --ff-only
else
	run_cmd git clone https://github.com/nvim-lua/plenary.nvim.git "$plenary_src"
fi
