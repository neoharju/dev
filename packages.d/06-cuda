#!/usr/bin/env bash
# packages.d/cuda -- CUDA toolkit + cuDNN
# TODO: install from source ?
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$script_dir/lib/common.sh"
# shellcheck source=../lib/optimize.sh
source "$script_dir/lib/optimize.sh"

log_info "---- cuda ----"

run_cmd sudo pacman -S --noconfirm --needed cuda cudnn nsight-systems nsight-compute

log_info "nvcc/cuda-gdb available at /opt/cuda/bin once a new shell picks up PATH"
log_info "nsys/ncu available directly on PATH (/usr/bin)"

