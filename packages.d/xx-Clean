#!/usr/bin/env bash
# packages.d/clean -- clean cache
#
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$script_dir/lib/common.sh"

log_info "---- Clean cache ----"
run_cmd sudo pacman -Scc

# used during some of our rust installs
run_cmd rm -rf "$HOME/.cargo/tmp/"

run_cmd npm cache clean --force
run_cmd go clean -cache -modcache
# 
run_cmd pip cache purge
run_cmd conda clean --all

