#!/usr/bin/env bash
# packages.d/clean -- clean cache
#
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../lib/common.sh
source "$script_dir/lib/common.sh"

log_info "---- Clean cache ----"
run_cmd sudo pacman -Scc

# used during some of our rust installs
run_cmd rm -rf "$HOME/.cargo/tmp/"

# ------------------------------------
run_if_exists() {
    local cmd=$1
    shift

    if command -v "$cmd" >/dev/null 2>&1; then
        run_cmd "$cmd" "$@"
    else
        log_info "skipping '$cmd' (not installed)"
    fi
}
# ------------------------------------

run_if_exists npm cache clean --force
run_if_exists go clean -cache -modcache
run_if_exists pip cache purge
run_if_exists conda clean --all

